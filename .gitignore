# Dependencias
**/node_modules/

# Env y secretos (nunca commitear el .env real)
**/.env
.env

# Estado runtime del proxy (se genera por provision.js)
sandbox-proxy/routes.json

# Certificados TLS
**/certs/

# Basura del SO
.DS_Store
**/.DS_Store

# Logs
*.log

# Export de sesión de Kiro (no es código; 1.7MB de historial de conversación)
demo-microVms/microvms.json

# Config autogenerada de code-server (contiene password; no versionar)
**/config/code-server/config.yaml

# Artefactos de build de la imagen MicroVM
**/kiro-sandbox.zip
**/code-artifact*.zip

# Python bytecode
**/__pycache__/
*.pyc

# .kiro generado por los scripts del workshop (los asistentes lo crean en vivo)
kiro-sandbox/workspace/kiro-day/.kiro/
