# =============================================================================
# sandbox-proxy — variables de entorno
# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
#
# NO pongas credenciales AWS aquí. En el EC2 el proxy usa el rol de la instancia
# (ingenis-server-role). El .env real NO debe commitearse (está en .gitignore).
# =============================================================================

# --- AWS ---------------------------------------------------------------------
# Región donde viven las MicroVMs y SES.
AWS_REGION=us-east-1

# ID de la cuenta (para construir el ARN de la imagen y del execution role).
ACCOUNT_ID=590183999298


# --- Dominio / enrutamiento --------------------------------------------------
# Dominio base. El proxy extrae el label del subdominio:
#   sa7s6a7.sandbox.awslearn.cloud  ->  label "sa7s6a7"
BASE_DOMAIN=sandbox.awslearn.cloud


# --- Puertos -----------------------------------------------------------------
# Puerto donde escucha el proxy dentro del contenedor (nginx le hace proxy_pass).
PORT=8443

# Puerto de la app dentro de la MicroVM (code-server). Se usa en allowedPorts del
# token y en el header X-aws-proxy-port.
SANDBOX_PORT=8080


# --- Tokens ------------------------------------------------------------------
# TTL del token de auth en minutos (máximo permitido por el servicio: 60).
TOKEN_TTL_MIN=60

# Margen (ms) para renovar el token ANTES de que expire. 600000 = 10 min.
REFRESH_MARGIN_MS=600000


# --- Rutas (mapa label -> microvm) -------------------------------------------
# Archivo compartido entre el proxy (lo lee) y provision.js (lo escribe).
# IMPORTANTE: se monta el DIRECTORIO data/ (no el archivo), para que las
# reescrituras de provision.js — que cambian el inode — se reflejen en el
# contenedor del proxy sin reiniciar. Montar un solo archivo ancla el inode y
# el proxy seguiría viendo la versión vieja.
ROUTES_FILE=/app/data/routes.json


# --- Imagen MicroVM (lo usa provision.js) ------------------------------------
# Nombre de la imagen kiro-sandbox desde la que se lanzan las MicroVMs.
IMAGE_NAME=kiro-sandbox
# Versión de imagen: SOLO es el DEFAULT/fallback. El valor REAL vive en
# data/config.json (campo imageVersion) y se cambia en caliente desde el MCP tras
# construir una nueva versión. provision.js lo lee de config.json vía fleet.js.
IMAGE_VERSION=7.0


# --- Registro self-service (QR -> formulario, día del evento) -----------------
# Host del sitio de registro. Las requests a este Host sirven el formulario y el
# endpoint /api/register; NO se proxyean a una MicroVM. Vive bajo el mismo árbol
# *.sandbox.awslearn.cloud, así que reusa el wildcard TLS y DNS que ya tenés (no
# necesita cert ni registro DNS aparte). Se intercepta antes de la lógica de
# proxy, por eso no colisiona con los labels de los sandboxes.
REGISTER_HOST=registro.sandbox.awslearn.cloud

# Cuántos sandboxes provisiona el worker EN PARALELO desde la cola. Bajo a propósito
# para no chocar con límites de RunMicrovm cuando llega un pico de registros.
PROVISION_CONCURRENCY=2

# NOTA: no hay rate limit por IP. En el evento todos comparten WiFi (misma IP tras
# NAT), así que limitar por IP bloquearía a personas distintas. La protección real
# es la idempotencia por email (un email = un sandbox) + el cap global de abajo.

# Máximo de sandboxes (cinturón de seguridad contra costos/abuso). El valor REAL
# vive en data/config.json y se puede cambiar en caliente (sin reiniciar) desde el
# MCP. Esta env var solo es el DEFAULT si config.json falta o es inválido.
MAX_SANDBOXES=60

# Interruptor del formulario de registro. Igual que MAX: el valor REAL vive en
# data/config.json (campo registrationEnabled) y se cambia en caliente desde el
# MCP para abrir el alta al arrancar el evento y cerrarla al terminar. Esta env
# var solo es el DEFAULT: pon 0 para que arranque cerrado si config.json falta.
REGISTRATION_ENABLED=1

# Vida máxima (TTL duro) de cada sandbox en SEGUNDOS. Al alcanzarla, la plataforma
# TERMINA la MicroVM sin importar la actividad (campo maximumDurationInSeconds de
# RunMicrovm). El valor REAL vive en data/config.json (campo sandboxMaxDurationSeconds)
# y se cambia en caliente desde el MCP (kiroday_set_sandbox_duration). Esta env var
# solo es el DEFAULT si config.json falta o es inválido. Rango 60–28800 (1 min–8 h);
# default 14400 = 4 h. Afecta solo a sandboxes creados DESPUÉS del cambio.
SANDBOX_MAX_DURATION_SECONDS=14400

# Archivo de config modificable en caliente (MAX + registrationEnabled). Igual que
# ROUTES_FILE: montar el DIRECTORIO data/, no el archivo.
CONFIG_FILE=/app/data/config.json


# --- Email (SES, lo usa provision.js) ----------------------------------------
# Dirección remitente. DEBE estar verificada en SES (dominio o email) en AWS_REGION.
# Si SES está en sandbox mode, los destinatarios también deben estar verificados.
SES_FROM=no-reply@awslearn.cloud

# Pon 1 para NO enviar email (solo crear la MicroVM y escribir la ruta). Útil para
# pruebas antes de tener SES verificado. Déjalo vacío o quítalo para enviar.
SKIP_EMAIL=1


# --- TLS (opcional) ----------------------------------------------------------
# Si defines ambos, el proxy termina TLS él mismo. Si los dejas vacíos, el proxy
# corre en HTTP y nginx se encarga del TLS wildcard (variante recomendada).
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem
