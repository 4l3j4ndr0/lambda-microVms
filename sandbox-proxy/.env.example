# =============================================================================
# sandbox-proxy — variables de entorno
# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
#
# NO pongas credenciales AWS aquí. En el EC2 el proxy usa el rol de la instancia
# (ingenis-server-role). El .env real NO debe commitearse (está en .gitignore).
# =============================================================================

# --- AWS ---------------------------------------------------------------------
# Región donde viven las MicroVMs y SES.
AWS_REGION=us-east-1

# ID de la cuenta (para construir el ARN de la imagen y del execution role).
ACCOUNT_ID=590183999298


# --- Dominio / enrutamiento --------------------------------------------------
# Dominio base. El proxy extrae el label del subdominio:
#   sa7s6a7.sandbox.awslearn.cloud  ->  label "sa7s6a7"
BASE_DOMAIN=sandbox.awslearn.cloud


# --- Puertos -----------------------------------------------------------------
# Puerto donde escucha el proxy dentro del contenedor (nginx le hace proxy_pass).
PORT=8443

# Puerto de la app dentro de la MicroVM (code-server). Se usa en allowedPorts del
# token y en el header X-aws-proxy-port.
SANDBOX_PORT=8080


# --- Tokens ------------------------------------------------------------------
# TTL del token de auth en minutos (máximo permitido por el servicio: 60).
TOKEN_TTL_MIN=60

# Margen (ms) para renovar el token ANTES de que expire. 600000 = 10 min.
REFRESH_MARGIN_MS=600000


# --- Rutas (mapa label -> microvm) -------------------------------------------
# Archivo compartido entre el proxy (lo lee) y provision.js (lo escribe).
# IMPORTANTE: se monta el DIRECTORIO data/ (no el archivo), para que las
# reescrituras de provision.js — que cambian el inode — se reflejen en el
# contenedor del proxy sin reiniciar. Montar un solo archivo ancla el inode y
# el proxy seguiría viendo la versión vieja.
ROUTES_FILE=/app/data/routes.json


# --- Imagen MicroVM (lo usa provision.js) ------------------------------------
# Nombre y versión de la imagen kiro-sandbox desde la que se lanzan las MicroVMs.
IMAGE_NAME=kiro-sandbox
IMAGE_VERSION=1.0


# --- Email (SES, lo usa provision.js) ----------------------------------------
# Dirección remitente. DEBE estar verificada en SES (dominio o email) en AWS_REGION.
# Si SES está en sandbox mode, los destinatarios también deben estar verificados.
SES_FROM=no-reply@awslearn.cloud

# Pon 1 para NO enviar email (solo crear la MicroVM y escribir la ruta). Útil para
# pruebas antes de tener SES verificado. Déjalo vacío o quítalo para enviar.
SKIP_EMAIL=1


# --- TLS (opcional) ----------------------------------------------------------
# Si defines ambos, el proxy termina TLS él mismo. Si los dejas vacíos, el proxy
# corre en HTTP y nginx se encarga del TLS wildcard (variante recomendada).
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem
